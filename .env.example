DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/infnet?sslmode=require
INFNET_ADMIN_TOKEN=replace-with-a-long-random-admin-token
INFNET_ADMIN_OPERATOR_TOKEN=replace-with-a-long-random-operator-token
INFNET_ADMIN_VIEWER_TOKEN=replace-with-a-long-random-viewer-token
INFNET_NODE_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token
INFNET_PAYMENT_WEBHOOK_SECRET=replace-with-payment-provider-webhook-secret
# Optional real checkout. Set provider=stripe and configure both Stripe secrets.
# INFNET_PAYMENT_PROVIDER=stripe
# INFNET_PUBLIC_URL=https://control.example.com
# STRIPE_SECRET_KEY=sk_live_replace
# STRIPE_WEBHOOK_SECRET=whsec_replace
# Optional distributed rate limiting. Without these values the app uses a bounded in-memory fallback.
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
# Set DATABASE_SSL=false only for a deliberately local/non-TLS-compatible database.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Optional edge-agent path; systemd defaults to /var/lib/infnet/agent-state.json
# INFNET_NODE_STATE_FILE=/var/lib/infnet/agent-state.json
# Optional for local development without PostgreSQL:
# INFNET_ALLOW_UNPAID_DEV=true
